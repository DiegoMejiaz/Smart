# ======================= TELEGRAM =======================
# Crea el bot con @BotFather y añádelo como ADMINISTRADOR del canal.
TELEGRAM_BOT_TOKEN=123456789:AAH...
# @nombre_del_canal (público) o id numérico (-100xxxxxxxxxx) para canales privados
TELEGRAM_CHANNEL_ID=@mi_canal_tipster
TELEGRAM_DRY_RUN=false
# Publica una señal de ejemplo (marcada como prueba) al arrancar el agente
SEND_TEST_SIGNAL_ON_START=false

# ======================= LLM (Claude) =======================
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_ENABLED=true

# ======================= BETANO =======================
# Dominio del país donde operas (.pe, .mx, .com.co, .cl, .pt, .de, .com...)
BETANO_BASE_URL=https://www.betano.pe
# Las listas se escriben en formato JSON
BETANO_SPORTS=["futbol","baloncesto","tenis"]
# Rutas de ligas concretas (opcional), copiadas de la URL de Betano
BETANO_LEAGUE_PATHS=[]
BETANO_USE_BROWSER_FALLBACK=false

# ======================= DATOS DE REFERENCIA =======================
# The Odds API: cuotas de casas "sharp" para validar el mercado (muy recomendado)
ODDS_API_KEY=
ODDS_API_SHARP_BOOKS=["pinnacle","betfair_ex_eu","matchbook"]
ODDS_API_SPORT_KEYS=["soccer_epl","soccer_spain_la_liga","soccer_italy_serie_a","soccer_germany_bundesliga","soccer_france_ligue_one","soccer_uefa_champs_league","basketball_nba","basketball_euroleague"]
# API-Football: forma, H2H, lesiones y xG (recomendado para fútbol)
API_FOOTBALL_KEY=

# ======================= RED / ANTI-BLOQUEO =======================
# Opción A (recomendada): Scrape.do descarga Betano desde una IP residencial del país.
# Si SCRAPE_DO_TOKEN está puesto, NO hacen falta PROXIES para Betano.
# Coste: 10 créditos por petición con SCRAPE_DO_SUPER=true (1 crédito con false).
SCRAPE_DO_TOKEN=
SCRAPE_DO_GEO=pe
SCRAPE_DO_SUPER=true
# Opción B: tus propios proxies residenciales.
# Proxies residenciales DEL PAÍS del dominio Betano (Betano geo-bloquea IPs de otros países/datacenter)
PROXIES=["http://user:pass@proxy1.example.com:8000","http://user:pass@proxy2.example.com:8000"]
REQUEST_TIMEOUT=20
REQUEST_MAX_RETRIES=4
MIN_REQUEST_DELAY=1.5
MAX_REQUEST_DELAY=4.0

# ======================= MOTOR DE VALOR =======================
MIN_ODDS=1.50
MAX_ODDS=2.30
MIN_EDGE=0.03
MIN_PROBABILITY=0.45
MAX_OVERROUND_REFERENCE=1.08
KELLY_FRACTION=0.25
HOURS_AHEAD=36
MIN_MINUTES_TO_START=30
MAX_PICKS_PER_CYCLE=3
MAX_PICKS_PER_DAY=10

# ======================= EJECUCIÓN =======================
POLL_INTERVAL_SECONDS=600
TIMEZONE=America/Lima
DB_PATH=data/tipster.db
LOG_LEVEL=INFO
LOG_DIR=logs
